{
  "name": "kingminos",
  "version": "0.0.0-dev",
  "description": "KingMinos CLI — call the KingMinos API from your terminal",
  "license": "MIT",
  "type": "module",
  "homepage": "https://kingminos.com/docs/cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outboundsync/kingminos-cli.git"
  },
  "bugs": {
    "url": "https://github.com/outboundsync/kingminos-cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kingminos": "./dist/kingminos.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts && node --test test/release-calver.test.mjs",
    "ci": "npm run typecheck && npm run test",
    "release:preview": "node scripts/release-calver.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
